<Window x:Class="SadeanID.GroupRightsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Group Rights - Sadean.id" Height="650" Width="1000" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Group Rights / Hak Akses" FontSize="28" FontWeight="Bold" Foreground="#172033"/><TextBlock Text="Atur hak akses menu berdasarkan role pengguna" Foreground="#718096" Margin="0,5,0,22"/></StackPanel>
<Border Grid.Row="1" Background="White" Padding="16" CornerRadius="8" Margin="0,0,0,16"><DockPanel><TextBlock Text="Role:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/><ComboBox x:Name="RoleComboBox" Width="230" Height="34" SelectedIndex="0"><ComboBoxItem Content="Administrator"/><ComboBoxItem Content="Pembelian"/><ComboBoxItem Content="Kasir"/><ComboBoxItem Content="Owner"/></ComboBox><Button DockPanel.Dock="Right" Content="＋  Tambah Role" Padding="16,7" Background="#2563EB" Foreground="White" BorderThickness="0"/></DockPanel></Border>
<Border Grid.Row="2" Background="White" Padding="18" CornerRadius="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="MENU / FITUR" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="LIHAT" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="TAMBAH" FontWeight="Bold"/><TextBlock Grid.Column="3" Text="EDIT" FontWeight="Bold"/><TextBlock Grid.Column="4" Text="HAPUS" FontWeight="Bold"/><TextBlock Grid.Column="5" Text="CETAK" FontWeight="Bold"/>
<ScrollViewer Grid.Row="1" Grid.ColumnSpan="6"><StackPanel><Separator Margin="0,10,0,4"/><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Dashboard"/><CheckBox Grid.Column="1" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="2" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="3" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="4" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="5" HorizontalAlignment="Left" IsChecked="True"/></Grid><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Master User"/><CheckBox Grid.Column="1" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="2" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="3" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="4" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="5" HorizontalAlignment="Left" IsChecked="True"/></Grid><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Master Barang"/><CheckBox Grid.Column="1" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="2" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="3" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="4" HorizontalAlignment="Left" IsChecked="True"/><CheckBox Grid.Column="5" HorizontalAlignment="Left" IsChecked="True"/></Grid><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Pembelian"/><CheckBox Grid.Column="1" HorizontalAlignment="Left"/><CheckBox Grid.Column="2" HorizontalAlignment="Left"/><CheckBox Grid.Column="3" HorizontalAlignment="Left"/><CheckBox Grid.Column="4" HorizontalAlignment="Left"/><CheckBox Grid.Column="5" HorizontalAlignment="Left"/></Grid><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Penjualan"/><CheckBox Grid.Column="1" HorizontalAlignment="Left"/><CheckBox Grid.Column="2" HorizontalAlignment="Left"/><CheckBox Grid.Column="3" HorizontalAlignment="Left"/><CheckBox Grid.Column="4" HorizontalAlignment="Left"/><CheckBox Grid.Column="5" HorizontalAlignment="Left"/></Grid></StackPanel></ScrollViewer></Grid></Border>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><TextBlock Text="Akses tanggal: " VerticalAlignment="Center"/><ComboBox Width="150" SelectedIndex="0" Margin="6,0,12,0"><ComboBoxItem Content="Semua tanggal"/><ComboBoxItem Content="Hari ini"/><ComboBoxItem Content="Data sendiri"/></ComboBox><Button Content="Simpan Hak Akses" Padding="18,9" Background="#16A34A" Foreground="White" BorderThickness="0" Click="SaveButton_Click"/></StackPanel></Grid></Window>