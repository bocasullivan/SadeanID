<Window x:Class="SadeanID.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sadean.id - Login" Height="460" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FB">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#172554" Grid.Column="0">
            <StackPanel VerticalAlignment="Center" Margin="32">
                <TextBlock Text="sadean.id" Foreground="White" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="Sales &amp; Inventory" Foreground="#9DB6EA" FontSize="14" Margin="2,6,0,0"/>
                <TextBlock Text="Kelola bisnis dengan lebih mudah." Foreground="#DCE7FF" TextWrapping="Wrap" Margin="2,42,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="58,30">
            <TextBlock Text="Selamat Datang" FontSize="28" FontWeight="Bold" Foreground="#172033"/>
            <TextBlock Text="Silakan masuk ke akun Anda" Foreground="#718096" Margin="0,6,0,28"/>
            <TextBlock Text="Username" Foreground="#374151" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameTextBox" Height="38" FontSize="15" Padding="10,7" Margin="0,7,0,16"/>
            <TextBlock Text="Password" Foreground="#374151" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Height="38" FontSize="15" Padding="10,7" Margin="0,7,0,4"/>
            <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="#DC2626" FontSize="12" Height="22"/>
            <Button Content="MASUK" Click="LoginButton_Click" Height="42" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            <TextBlock Text="Demo: admin / admin" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>
    </Grid>
</Window>