<Window x:Class="SadeanID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sadean.id - Transaksi" Height="720" Width="1200"
        MinHeight="600" MinWidth="1000" WindowStartupLocation="CenterScreen"
        Background="#F5F7FB">
    <Window.Resources>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderButton" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" BorderThickness="0" Padding="18,12" Cursor="Hand">
                                <Grid Width="204"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding Header}" TextElement.Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock x:Name="Arrow" Grid.Column="1" Text="›" FontSize="20" Foreground="#9DB6EA" VerticalAlignment="Center"/></Grid>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" ContentSource="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Visible"/><Setter TargetName="Arrow" Property="Text" Value="⌄"/></Trigger>
                            <Trigger SourceName="HeaderButton" Property="IsMouseOver" Value="True"><Setter TargetName="HeaderButton" Property="Background" Value="#263D78"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#172554">
            <StackPanel>
                <StackPanel Margin="20,28,20,24">
                    <TextBlock Text="sadean.id" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Sales &amp; Inventory" Foreground="#9DB6EA" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="MENU UTAMA" Foreground="#7894CC" FontSize="11" FontWeight="Bold" Margin="20,0,20,8"/>
                                                <Button Content="▣   Dashboard" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="18,12" HorizontalContentAlignment="Left"/>
                <Expander Header="▤   Master Data" Expanded="MenuExpander_Expanded">
                    <StackPanel Margin="0,8,0,0" TextElement.Foreground="White">
                        <Button Content="User" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Group Rights" Click="GroupRightsButton_Click" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Barang" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Customer" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Supplier" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Expander>
                <Expander Header="⇄   Transaksi" Expanded="MenuExpander_Expanded">
                    <StackPanel Margin="0,8,0,0" TextElement.Foreground="White">
                        <Button Content="Pembelian" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Penjualan" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Retur Pembelian" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Retur Penjualan" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Expander>
                <Expander Header="▥   Laporan" Expanded="MenuExpander_Expanded">
                    <StackPanel Margin="0,8,0,0" TextElement.Foreground="White">
                        <Button Content="Laporan Penjualan" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Laporan Pembelian" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Laporan Stok" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                        <Button Content="Kartu Stok" Foreground="#DCE7FF" Background="Transparent" BorderThickness="0" Padding="28,8" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,28">
                <TextBlock Text="Transaksi" FontSize="28" FontWeight="Bold" Foreground="#172033"/>
                <TextBlock Text="Kelola pembelian, penjualan, dan retur barang" Foreground="#718096"/>
            </StackPanel>
            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,28">
                <Border Background="White" CornerRadius="10" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="TOTAL BARANG" Foreground="#718096" FontSize="11" FontWeight="Bold"/><TextBlock Text="0" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Data master barang" Foreground="#94A3B8"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="PENJUALAN HARI INI" Foreground="#718096" FontSize="11" FontWeight="Bold"/><TextBlock Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,8,0,0"/><TextBlock Text="Belum ada transaksi" Foreground="#94A3B8"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="PEMBELIAN HARI INI" Foreground="#718096" FontSize="11" FontWeight="Bold"/><TextBlock Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,8,0,0"/><TextBlock Text="Belum ada transaksi" Foreground="#94A3B8"/></StackPanel></Border>
                <Border Background="White" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="STOK MENIPIS" Foreground="#718096" FontSize="11" FontWeight="Bold"/><TextBlock Text="0" FontSize="30" FontWeight="Bold" Foreground="#EA580C" Margin="0,8,0,0"/><TextBlock Text="Perlu diperhatikan" Foreground="#94A3B8"/></StackPanel></Border>
            </UniformGrid>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="White" CornerRadius="10" Padding="22" Margin="0,0,14,0"><StackPanel><TextBlock Text="Transaksi Terbaru" FontSize="18" FontWeight="Bold"/><TextBlock Text="Belum ada transaksi" Foreground="#94A3B8" Margin="0,22,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="White" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="Aksi Transaksi" FontSize="18" FontWeight="Bold"/><Button Content="＋  Buat Pembelian" Margin="0,18,0,8" Padding="12" Background="#EFF6FF" Foreground="#2563EB" BorderThickness="0" HorizontalContentAlignment="Left"/><Button Content="＋  Buat Penjualan" Padding="12" Background="#F0FDF4" Foreground="#16A34A" BorderThickness="0" HorizontalContentAlignment="Left"/></StackPanel></Border></Grid>
        </Grid>
    </Grid>
</Window>

